# GameStrike.io Backend Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=https://gamestrike.io

# MongoDB Connection (Local or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/gamestrike_io

# Auth JWT Secret
JWT_SECRET=change_me_in_production

# Default Admin Credentials
ADMIN_EMAIL=admin@gamestrike.io
ADMIN_PASSWORD=Admin@1234

# CashTap Checkout API (https://cashtap.cash/llms.txt)
CASHTAP_SECRET_KEY=sk_live_YOUR_CASHTAP_SECRET_KEY
CASHTAP_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Juwa 777 External API (https://external.juwa777.com)
JUWA_BASE_URL=https://external.juwa777.com
JUWA_AGENT_ID=YOUR_JUWA_AGENT_ID
JUWA_SECRET_KEY=YOUR_JUWA_SECRET_KEY

# Game Vault 999 External API (https://apius.gamevault999.com)
GAMEVAULT_BASE_URL=https://apius.gamevault999.com
GAMEVAULT_AGENT_ID=YOUR_GAMEVAULT_AGENT_ID
GAMEVAULT_SECRET_KEY=YOUR_GAMEVAULT_SECRET_KEY

# Hostinger SMTP Email (for Signup & Forgot Password OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@gamestrike.io
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM=GameStrike.io <support@gamestrike.io>

# Web Push VAPID Keys (auto-generated on startup if left empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gamestrike.io

# Firebase Cloud Messaging. Point this at the service account JSON.
# Keep that file out of git.
FIREBASE_SERVICE_ACCOUNT_PATH=../gamestrike-f1060-firebase-adminsdk-fbsvc-2f55828df4.json
FCM_SERVER_KEY=

# Free support chat. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
